# ===========================================
# Chronarr Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# Sensitive values (API keys, passwords) belong in .env.secrets — keep that file out of git.
#
# WEBHOOK URLS for your Radarr/Sonarr instances:
#   Single instance (default):  http://chronarr:8080/radarr/webhook
#                               http://chronarr:8080/sonarr/webhook
#   Named instances:            http://chronarr:8080/radarr_4k/webhook
#                               http://chronarr:8080/sonarr_4k/webhook
#   (Webhook URLs are built automatically from instance names in this file)

# ===========================================
# CHRONARR DATABASE
# ===========================================
# Internal Chronarr database — stores your media dates and metadata.
# PostgreSQL is strongly recommended for production.

DB_TYPE=postgresql
DB_HOST=chronarr-db
DB_PORT=5432
DB_NAME=chronarr
DB_USER=chronarr
# DB_PASSWORD= → set in .env.secrets

# SQLite alternative (not recommended for production):
# DB_TYPE=sqlite
# DB_PATH=/app/data/media_dates.db

# ===========================================
# SERVER CONFIGURATION
# ===========================================
TZ=America/New_York

# Core API — handles webhooks and processing
CORE_API_HOST=0.0.0.0
CORE_API_PORT=8080

# Web dashboard
WEB_HOST=0.0.0.0
WEB_PORT=8081
WEB_WORKERS=1
WEB_EXTERNAL_PORT=8081

# ===========================================
# RADARR — MAIN INSTANCE
# ===========================================
# Paths: RADARR_ROOT_FOLDERS is what Radarr sees on the host (or UNC path on Windows).
#        RADARR_MOVIE_PATHS is what Chronarr sees inside the container.
#        Both are comma-separated.
#
# IMPORTANT — multi-instance users:
#   Define paths per-instance (RADARR_MOVIE_PATHS, RADARR_4K_MOVIE_PATHS, etc.)
#   Do NOT use the global MOVIE_PATHS key when running multiple instances —
#   if it appears more than once in your env file, Docker only keeps the last
#   definition and silently drops the others.

RADARR_URL=http://radarr:7878
# RADARR_API_KEY= → set in .env.secrets
# RADARR_WEBHOOK_SECRET= → set in .env.secrets (optional, for webhook validation)
RADARR_ROOT_FOLDERS=/mnt/unionfs/Media/Movies/movies
RADARR_MOVIE_PATHS=/media/movies

# Radarr database (direct DB access — faster than API for large libraries)
RADARR_DB_TYPE=postgresql
RADARR_DB_HOST=your-radarr-db-host
RADARR_DB_PORT=5432
RADARR_DB_NAME=radarr-main
RADARR_DB_USER=postgres
# RADARR_DB_PASSWORD= → set in .env.secrets

# SQLite alternative:
# RADARR_DB_TYPE=sqlite
# RADARR_DB_PATH=/path/to/radarr.db

# ===========================================
# RADARR — ADDITIONAL INSTANCES (OPTIONAL)
# ===========================================
# Add a block per extra Radarr instance. The name between RADARR_ and _URL
# becomes part of the webhook URL: RADARR_4K_URL → /radarr_4k/webhook
# Names must be uppercase letters and underscores only.
#
# Each instance defines ALL of its own settings here — URL, API key, paths,
# and database access. Do NOT set MOVIE_PATHS again in this block; use
# RADARR_4K_MOVIE_PATHS instead. If MOVIE_PATHS appears twice in your env
# file, Docker only keeps the last value and silently drops the first.
#
# After configuring instances, visit http://your-server:8081/setup
# for the exact webhook URLs to paste into each Radarr instance.

# RADARR_4K_URL=http://radarr4k:7878
# RADARR_4K_API_KEY= → set in .env.secrets
# RADARR_4K_WEBHOOK_SECRET= → set in .env.secrets (optional)
# RADARR_4K_ROOT_FOLDERS=/mnt/unionfs/Media/Movies/movies4k
# RADARR_4K_MOVIE_PATHS=/media/movies4k   ← per-instance paths, NOT MOVIE_PATHS
# RADARR_4K_DB_TYPE=postgresql
# RADARR_4K_DB_HOST=your-radarr-4k-db-host
# RADARR_4K_DB_PORT=5432
# RADARR_4K_DB_NAME=radarr-4k
# RADARR_4K_DB_USER=postgres
# RADARR_4K_DB_PASSWORD= → set in .env.secrets
# SQLite: RADARR_4K_DB_TYPE=sqlite / RADARR_4K_DB_PATH=/radarr-4k-data/radarr.db

# ===========================================
# SONARR — MAIN INSTANCE
# ===========================================
# Same paths rule as Radarr: use SONARR_TV_PATHS here, not the global TV_PATHS,
# so each instance's paths stay self-contained.
SONARR_URL=http://sonarr:8989
# SONARR_API_KEY= → set in .env.secrets
# SONARR_WEBHOOK_SECRET= → set in .env.secrets (optional)
SONARR_ROOT_FOLDERS=/mnt/unionfs/Media/TV/tv
SONARR_TV_PATHS=/media/tv

# Sonarr database
SONARR_DB_TYPE=postgresql
SONARR_DB_HOST=your-sonarr-db-host
SONARR_DB_PORT=5432
SONARR_DB_NAME=sonarr-main
SONARR_DB_USER=postgres
# SONARR_DB_PASSWORD= → set in .env.secrets

# SQLite alternative:
# SONARR_DB_TYPE=sqlite
# SONARR_DB_PATH=/path/to/sonarr.db

# ===========================================
# SONARR — ADDITIONAL INSTANCES (OPTIONAL)
# ===========================================
# Same rule: use SONARR_4K_TV_PATHS, NOT TV_PATHS, in additional instance blocks.
# SONARR_4K_URL=http://sonarr4k:8989
# SONARR_4K_API_KEY= → set in .env.secrets
# SONARR_4K_WEBHOOK_SECRET= → set in .env.secrets (optional)
# SONARR_4K_ROOT_FOLDERS=/mnt/unionfs/Media/TV/tv4k
# SONARR_4K_TV_PATHS=/media/tv4k              ← per-instance paths, NOT TV_PATHS
# SONARR_4K_DB_TYPE=postgresql
# SONARR_4K_DB_HOST=your-sonarr-4k-db-host
# SONARR_4K_DB_PORT=5432
# SONARR_4K_DB_NAME=sonarr-4k
# SONARR_4K_DB_USER=postgres
# SONARR_4K_DB_PASSWORD= → set in .env.secrets

# ===========================================
# EXTERNAL APIs (OPTIONAL)
# ===========================================
# Jellyseerr — for request tracking
# JELLYSEERR_URL=http://jellyseerr:5055
# JELLYSEERR_API_KEY= → set in .env.secrets

# TMDB — for release date and metadata lookup
# TMDB_API_KEY= → set in .env.secrets
TMDB_COUNTRY=US
# TMDB_TYPE_PRIORITY=movie,tv

# TVDB — for TV episode air dates
# TVDB_API_KEY= → set in .env.secrets
# DISABLE_TVDB=false

# OMDB — fallback metadata source
# OMDB_API_KEY= → set in .env.secrets

# ===========================================
# MOVIE PROCESSING
# ===========================================
# Priority for determining which date to use
# Options: import_then_digital, digital_only, theatrical_only
MOVIE_PRIORITY=import_then_digital

# Order to check release date types
RELEASE_DATE_PRIORITY=digital,physical,theatrical

# Prefer API release dates over file modification dates
PREFER_RELEASE_DATES_OVER_FILE_DATES=true

# Allow file modification date as a last-resort fallback
ALLOW_FILE_DATE_FALLBACK=false

# How to handle existing dates in the database
# Options: backfill_only (fill missing), overwrite (always update)
MOVIE_DATE_UPDATE_MODE=backfill_only

# When to poll for movie date data
# Options: always, missing_only, never
MOVIE_POLL_MODE=always

# Smart date validation — rejects dates that seem implausible
ENABLE_SMART_DATE_VALIDATION=true
MAX_RELEASE_DATE_GAP_YEARS=10

# Remove movies from DB that have been missing for N days (0 = disabled)
PURGE_MISSING_MOVIES_DAYS=0

# ===========================================
# TV PROCESSING
# ===========================================
TV_WEBHOOK_PROCESSING_MODE=targeted

# Season directory naming — must match your actual folder names
TV_SEASON_DIR_FORMAT=Season {season:02d}
TV_SEASON_DIR_PATTERN=season

# Remove TV shows from DB that have been missing for N days (0 = disabled)
PURGE_MISSING_TV_DAYS=0

# ===========================================
# PERFORMANCE & BATCHING
# ===========================================
BATCH_DELAY=5.0
MAX_CONCURRENT_SERIES=3
SEQUENTIAL_DELAY=20.0
TIMEOUT_SECONDS=45

# ===========================================
# WEB INTERFACE
# ===========================================
WEB_AUTH_ENABLED=false
# WEB_AUTH_USERNAME=admin
# WEB_AUTH_PASSWORD= → set in .env.secrets
WEB_AUTH_SESSION_TIMEOUT=3600

# Dashboard display
# APP_TITLE=Chronarr
# APP_SUBTITLE=Database Management & Reporting
PAGINATION_LIMIT=50
REFRESH_INTERVAL=30

# ===========================================
# DEBUGGING
# ===========================================
DEBUG=false
PATH_DEBUG=false
LOG_DIR=/app/data/logs

# ===========================================
# LEGACY — PENDING REMOVAL
# ===========================================
# These settings controlled NFO file writing, which was the original mechanism
# for pushing dates into Emby/Jellyfin. The Emby/Jellyfin plugins now read
# directly from Chronarr's database, making this code path obsolete.
# These vars and the code behind them will be removed in a future release.
# Changing these values currently has no meaningful effect.
#
# MANAGE_NFO=true
# FIX_DIR_MTIMES=true
# LOCK_METADATA=true
# MANUAL_SCAN_PRIORITIZE_NFO=false
